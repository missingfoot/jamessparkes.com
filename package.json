{
  "name": "jamessparkes.com",
  "version": "1.0.0",
  "description": "James Sparkes Portfolio Website",
  "type": "module",
  "scripts": {
    "start": "set NODE_NO_WARNINGS=1 && serve -s . -l 8080",
    "build:css": "tailwindcss -i ./styles/input.css -o ./styles/output.css --watch",
    "build:css:prod": "tailwindcss -i ./styles/input.css -o ./styles/output.css --minify",
    "dev": "set NODE_NO_WARNINGS=1 && concurrently \"npm run build:css\" \"npm start\""
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.0"
  }
}
