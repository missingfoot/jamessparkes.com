---
// src/components/ProjectLayout.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  tags: string[];
  images: { src: ImageMetadata; alt: string }[];
  path: string;
}
const { title, description, tags, images, path } = Astro.props;
---
<BaseLayout title={`${title} — James Sparkes`} description={description} path={path}>
  <div class="project-view">
    <h1 class="project-title">{title}</h1>
    <div class="project-tags">{tags.map((t) => <span>{t}</span>)}</div>
    <p class="project-description">{description}</p>
  </div>

  {images.length > 0 && (
    <div class="project-images">
      {images.map((img, i) => (
        <div class="project-thumb" data-index={i}>
          <Image src={img.src} alt={img.alt} loading="lazy" />
        </div>
      ))}
    </div>
  )}

  <div class="project-view">
    <div class="project-case-study">
      <slot />
    </div>
  </div>

  <script slot="scripts" src="/js/lightbox.js" defer></script>
</BaseLayout>
