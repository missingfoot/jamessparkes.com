---
// src/components/ProjectLayout.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { tagTip } from '../data/tag-glossary';
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  seoTitle?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  description: string;
  tags: string[];
  images: { src: ImageMetadata; alt: string }[];
  path: string;
  role?: string;
  years?: string;
  highlights?: { value: string; label: string }[];
}
const { title, seoTitle, cover, coverAlt, description, tags, images, path, role, years, highlights = [] } = Astro.props;
const pageTitle = seoTitle ? `${title}: ${seoTitle} — James Sparkes` : `${title} — James Sparkes`;
// Link previews (LinkedIn, Slack, iMessage) show the project's own cover, cropped to 1200×630
const ogImage = cover
  ? await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;

// Previous / next follow the sidebar order: work first, then personal.
const all = (await getCollection('projects', ({ data }) => data.visible)).sort((a, b) => a.data.order - b.data.order);
const sequence = [...all.filter((p) => p.data.category === 'work'), ...all.filter((p) => p.data.category === 'personal')]
  .map((p) => ({ title: p.data.title, href: `/${p.data.category}/${p.id}/` }));
const here = sequence.findIndex((p) => p.href === `${path}/`);
const prev = here > 0 ? sequence[here - 1] : undefined;
const backHref = path.startsWith('/personal') ? '/#personal' : '/#work';
const next = here >= 0 && here < sequence.length - 1 ? sequence[here + 1] : undefined;
---
<BaseLayout title={pageTitle} description={description} path={path} ogImage={ogImage && { src: ogImage.src, width: 1200, height: 630, alt: coverAlt ?? (seoTitle ? `${title}: ${seoTitle}` : title) }} ogType="article">
  <div class="back-rail">
    <a class="btn btn--sm btn--float round-button back-button" href={backHref} aria-label="Back to projects" data-back>
      <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    </a>
  </div>

  <div class="project-view">
    <h1 class="project-title">{title}</h1>
    <div class="project-tags">{tags.map((t) => {
      const tip = tagTip(t);
      return tip
        ? <span class="tag-chip has-tip" tabindex="0" data-tip={tip} aria-label={`${t}: ${tip}`}>{t}</span>
        : <span class="tag-chip">{t}</span>;
    })}</div>
    <p class="project-description">{description}</p>

    {highlights.length > 0 && (
      <section class="project-highlights" aria-labelledby="highlights-heading">
        <div class="highlights-head">
          <h2 id="highlights-heading" class="highlights-title">What I achieved</h2>
          {(role || years) && <div class="highlights-role">{[role, years].filter(Boolean).join(' · ')}</div>}
        </div>
        <ul class="highlights-grid" data-count={highlights.length}>
          {highlights.map((h) => (
            <li class="highlight">
              <span class="highlight-value">{h.value}</span>
              <span class="highlight-label">{h.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  {images.length > 0 && (
    <div class="project-images">
      {images.map((img, i) => (
        <div class="project-thumb" data-index={i}>
          <Image src={img.src} alt={img.alt} loading="lazy" />
        </div>
      ))}
    </div>
  )}

  <div class="project-view">
    <div class="project-case-study">
      <slot />
    </div>

    {(prev || next) && (
      <nav class="project-pager" aria-label="More projects">
        {prev ? (
          <a class="pager-link pager-prev" href={prev.href} rel="prev">
            <span class="pager-label">&larr; Previous</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager-link pager-next" href={next.href} rel="next">
            <span class="pager-label">Next &rarr;</span>
            <span class="pager-title">{next.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>

  <div class="top-rail">
    <button type="button" class="btn btn--sm btn--float round-button to-top" aria-label="Back to top" data-to-top>
      <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
    </button>
  </div>

  <script slot="scripts" src="/js/lightbox.js" defer></script>
</BaseLayout>

<script>
  // Back: return to wherever you came from on this site (keeps the About page's scroll and tab),
  // otherwise fall through to the link, which opens the right tab.
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
    try {
      if (document.referrer && new URL(document.referrer).origin === location.origin && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    } catch {}
  });

  // Back to top: shows once you've scrolled a screen's worth.
  const toTop = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (toTop) {
    const sync = () => toTop.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.75);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    toTop.addEventListener('click', () => {
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
    });
  }

  // Keep tag tooltips on screen: chips near the right edge open their tooltip leftwards.
  const place = (chip: Element) => {
    chip.classList.remove('tip-left');
    if (chip.getBoundingClientRect().left + 250 > window.innerWidth - 8) chip.classList.add('tip-left');
  };
  document.querySelectorAll('.tag-chip.has-tip').forEach((chip) => {
    chip.addEventListener('mouseenter', () => place(chip));
    chip.addEventListener('focus', () => place(chip));
  });
</script>
