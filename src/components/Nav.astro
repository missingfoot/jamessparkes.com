---
// src/components/Nav.astro
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.visible)).sort(
  (a, b) => a.data.order - b.data.order
);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (currentPath === href ? ' active' : '');
---
<aside class="nav">
  <details class="nav-details" open>
    <summary class="nav-summary">
      <div class="nav-identity">
        <div class="nav-name">James Sparkes</div>
        <div class="nav-role">Product Designer</div>
      </div>
      <span class="nav-toggle-label">Menu
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-toggle-icon"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      </span>
    </summary>
    <nav class="nav-groups">
      <div class="nav-group">
        <div class="nav-group-header">Info</div>
        <a class={`nav-item${isActive('/')}`} href="/">About</a>
        <a class={`nav-item${isActive('/cv')}`} href="/cv">CV</a>
      </div>
      <div class="nav-group">
        <div class="nav-group-header">Work</div>
        {projects.map((project) => (
          <a class={`nav-item${isActive(`/work/${project.id}`)}`} href={`/work/${project.id}`}>
            {project.data.title}
          </a>
        ))}
      </div>
    </nav>
  </details>
  <div class="nav-actions">
    <button class="nav-theme-toggle" data-theme-toggle>
      <span class="theme-label">dark</span>
    </button>
    <a class="nav-download" href="/james-sparkes-cv.pdf" target="_blank" rel="noopener">Download CV <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></a>
  </div>
  <script is:inline>(function(){
      var details = document.querySelector(".nav-details");
      var mq = window.matchMedia("(max-width: 767px)");
      function sync(e){
          if (e.matches) details.removeAttribute("open");
          else details.setAttribute("open", "");
      }
      sync(mq);
      mq.addEventListener("change", sync);
  })();</script>
</aside>
