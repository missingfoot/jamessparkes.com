---
// src/components/Nav.astro
import NavLinks from './NavLinks.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!-- Desktop sidebar: always visible ≥768px, no toggle, no JS -->
<aside class="nav-desktop">
  <div class="nav-identity">
    <div class="nav-name">James Sparkes</div>
    <div class="nav-role">Product Designer</div>
  </div>
  <NavLinks currentPath={currentPath} />
  <div class="nav-actions">
    <button class="nav-theme-toggle" data-theme-toggle>
      <span class="theme-label">dark</span>
    </button>
    <a class="nav-download" href="/james-sparkes-cv.pdf" target="_blank" rel="noopener">Download CV <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></a>
  </div>
</aside>

<!-- Mobile nav: fixed top bar + full-viewport overlay panel, <768px -->
<div class="nav-mobile" data-mobile-nav>
  <div class="nav-mobile-bar">
    <div class="nav-identity">
      <div class="nav-name">James Sparkes</div>
      <div class="nav-role">Product Designer</div>
    </div>
    <button class="nav-mobile-toggle" data-mobile-nav-toggle aria-expanded="false" aria-controls="nav-mobile-panel">
      Menu
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-mobile-toggle-icon"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
    </button>
  </div>
  <div class="nav-mobile-panel" id="nav-mobile-panel" data-mobile-nav-panel>
    <NavLinks currentPath={currentPath} />
    <div class="nav-actions">
      <button class="nav-theme-toggle" data-theme-toggle>
        <span class="theme-label">dark</span>
      </button>
      <a class="nav-download" href="/james-sparkes-cv.pdf" target="_blank" rel="noopener">Download CV <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg></a>
    </div>
  </div>
</div>

<script is:inline>(function(){
    var root = document.querySelector('[data-mobile-nav]');
    if (!root) return;
    var toggle = root.querySelector('[data-mobile-nav-toggle]');
    var panel = root.querySelector('[data-mobile-nav-panel]');

    function isOpen() {
        return root.classList.contains('open');
    }

    function setOpen(open) {
        root.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', function () {
        setOpen(!isOpen());
    });

    // Tap outside the panel's content (on the panel's own background) closes it.
    panel.addEventListener('click', function (e) {
        if (e.target === panel) setOpen(false);
    });
})();</script>
