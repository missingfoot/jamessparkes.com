---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import portraitDark from '../assets/images/james-sparkes-dark.jpg';
import portraitLight from '../assets/images/james-sparkes-light.jpg';
import { yearsExperience } from '../data/career';

const portraitDarkImg = await getImage({ src: portraitDark, width: 320, height: 320 });
const portraitLightImg = await getImage({ src: portraitLight, width: 320, height: 320 });

// Structured data so search engines know who this site is about
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'James Sparkes',
    jobTitle: 'Senior Product Designer',
    description: `Senior product designer with ${yearsExperience} years of experience in UX/UI design, front-end development and building digital products.`,
    url: Astro.site?.href,
    image: new URL(portraitLightImg.src, Astro.site).href,
    email: 'mailto:hello@jamessparkes.com',
    address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Canterbury Christ Church University' },
    knowsAbout: ['Product design', 'UX design', 'UI design', 'Design systems', 'User research', 'Interaction design', 'Prototyping', 'Front-end development', 'React', 'Healthtech', 'B2B SaaS'],
    sameAs: ['https://uk.linkedin.com/in/jamessparkesdesign', 'https://github.com/missingfoot'],
  },
};

const projects = (await getCollection('projects', ({ data }) => data.visible)).sort(
  (a, b) => a.data.order - b.data.order
);
const timelineGroups = [
  { label: 'Work', category: 'work' },
  { label: 'Personal', category: 'personal' },
].map((group) => ({
  ...group,
  projects: projects.filter((project) => project.data.category === group.category),
}));
---
<BaseLayout
  title="James Sparkes — Senior Product Designer, London"
  ogType="profile"
  jsonLd={jsonLd}
  description={`Senior product designer with ${yearsExperience} years of experience in UX/UI design, front-end development, and building digital products. Based in London.`}
  path="/"
>
  <div class="about-view">
    <img
      data-light-src={portraitLightImg.src}
      data-dark-src={portraitDarkImg.src}
      alt="James Sparkes"
      class="about-avatar"
      width="320"
      height="320"
    />
    <script is:inline>
      (function () {
        var img = document.currentScript.previousElementSibling;
        function sync() {
          var theme = document.documentElement.getAttribute('data-theme');
          var next = theme === 'light' ? img.dataset.lightSrc : img.dataset.darkSrc;
          if (img.src !== next) img.src = next;
        }
        sync();
        new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
    <h1 class="visually-hidden">James Sparkes, Senior Product Designer in London</h1>

    <div class="about-bio">
      <p class="about-intro">I'm a senior product designer who owns the whole journey, from talking to users through to shipping real frontend code, designing workflows that get people from A to B so the software fades into their day.</p>

      <details class="about-more">
        <summary><span class="about-more-open">Read more</span><span class="about-more-close">Read less</span></summary>
        <p>I'm a product designer specialising in UI/UX for mobile apps, SaaS platforms, web apps, and websites. I own design end-to-end, from research through to production frontend code, designing in Figma, in code, or whatever medium best communicates an idea, which means I understand both sides of the handoff between design and engineering rather than handing off and stepping away.</p>

        <p>A big part of how I work is talking directly to users and getting into their actual workflows before designing solutions, digging into the details that get overlooked but that make the difference between a mediocre product and a great one. What's always mattered most to me isn't UX for its own sake, it's designing workflows that get people from A to B in the best way possible, so a digital system fades naturally into their everyday work.</p>

        <p>I'm an adaptable problem-solver who cares about product adoption and client satisfaction as much as a beautiful interface. Strategy, storytelling, and business outcomes are central to how I design, and I've spent years designing for accessibility and for users with very different comfort levels with technology. I also think interaction design is one of the most important parts of the craft, and it's what people subconsciously read as good design even when it isn't pretty. That combination is what makes products people actually want to use.</p>

        <p>Outside of client work, I'm into open source and building CLI and GUI programs for Linux, and I enjoy the games industry, learning how games get made, and even building some small games myself as a way to understand systems from first principles, from a game loop to physics to rendering built up from scratch. That same instinct, wanting to see and control every part of a system rather than trust a black box, is what I bring to product design too. I adapt quickly to new tools and make use of AI, but critical thinking, empathy, and real problem-solving stay at the core of the work.</p>
      </details>
    </div>

    <p class="about-status"><span class="about-status-dot" aria-hidden="true"></span>Open to senior product design roles · London, hybrid or remote</p>

    <div class="about-links">
      <a href="/cv/">CV</a>
      <a href="https://uk.linkedin.com/in/jamessparkesdesign" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/missingfoot" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:hello@jamessparkes.com" id="contact-link">Contact</a>
    </div>

    <div class="timeline-tabs" role="tablist" aria-label="Projects" hidden>
      {timelineGroups.map((group, i) => (
        <button type="button" class="timeline-tab" role="tab" id={`tab-${group.category}`} aria-controls={`panel-${group.category}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={group.category}>
          {group.label} <span class="timeline-tab-count">{group.projects.length}</span>
        </button>
      ))}
    </div>

    {timelineGroups.map((group) => (
      <section class="timeline-group" id={`panel-${group.category}`} role="tabpanel" aria-labelledby={`tab-${group.category}`} data-panel={group.category}>
        <h2 class="timeline-header">{group.label}</h2>
        <ol class="timeline">
          {group.projects.map((project) => {
            const cover = project.data.cover ?? project.data.images[0]?.src;
            return (
              <li class="timeline-item">
                <a class="timeline-link" href={`/${project.data.category}/${project.id}/`}>
                  <div class="timeline-head">
                    {project.data.years && <div class="timeline-years">{project.data.years}</div>}
                    {project.data.kind && <div class="timeline-kind"><span class={`kind-tag kind-${project.data.kind.toLowerCase()}`}>{project.data.kind}</span></div>}
                    <h3 class="timeline-title">{project.data.title}</h3>
                  </div>
                  {project.data.summary && <p class="timeline-summary">{project.data.summary}</p>}
                  <div class="timeline-thumb">
                    {cover && <Image src={cover} alt="" width={1200} widths={[600, 900, 1200, 1600]} sizes="(max-width: 640px) 100vw, 700px" loading="lazy" />}
                  </div>
                  <div class="timeline-tags">{project.data.tags.map((t) => <span class="tag-chip">{t}</span>)}</div>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>

  <script slot="scripts" src="/js/avatar-game.js" defer></script>
</BaseLayout>

<script>
  // Work / Personal tabs. Without JS both lists simply show one after the other.
  const tabs = document.querySelector<HTMLElement>('.timeline-tabs');
  if (tabs) {
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('.timeline-tab')];
    const panels = [...document.querySelectorAll<HTMLElement>('.timeline-group[data-panel]')];
    const show = (name: string, remember = true) => {
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === name)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
      if (remember) { try { sessionStorage.setItem('home-tab', name); } catch {} }
    };
    tabs.hidden = false;
    document.documentElement.classList.add('has-tabs');
    let start = location.hash === '#personal' ? 'personal' : 'work';
    if (!location.hash) { try { start = sessionStorage.getItem('home-tab') || start; } catch {} }
    show(start, false);
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
    tabs.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const i = buttons.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      const next = buttons[(i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length];
      next.focus(); show(next.dataset.tab!);
    });
  }
</script>
