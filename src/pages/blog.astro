---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugify, byNewest } from '../lib/blog-filter';
import deadLinkReport from '../data/blog-dead-links.json';

const posts = (await getCollection('blog')).sort((a, b) => byNewest(a.data, b.data));

// Dev server only: a "Needs fixing" filter for posts with dead links (npm run blog:check-links)
const showFixing = import.meta.env.DEV;
const dead: Record<string, string> = showFixing ? deadLinkReport.dead : {};
const deadIn = (body = '') => Object.keys(dead).filter((url) => body.includes(url));
const fixingCount = posts.filter((p) => deadIn(p.body).length > 0).length;

const counts = new Map<string, number>();
for (const p of posts) for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
const categories = [...counts].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, slug: slugify(name), count }));

const years = posts.map((p) => p.data.date.getUTCFullYear());
const range = `${Math.min(...years)}–${Math.max(...years)}`;

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const rendered = await Promise.all(posts.map(async (post) => ({ post, Content: (await render(post)).Content })));
---
<BaseLayout
  title="Uni Blog — James Sparkes"
  description="My university design blog from 2011–2013: graphic design, photo manipulation, 3D and typography coursework, research and inspiration."
  path="/blog/"
>
  <div class="blog-view" data-cats={[...categories.map((c) => c.slug), ...(showFixing ? ['needs-fixing'] : [])].join(' ')}>
    {showFixing && <script type="application/json" id="blog-dead-links" set:html={JSON.stringify(dead)} />}
    <aside class="blog-side">
      <header class="blog-header">
        <h1 class="project-title">Uni Blog</h1>
        <p class="blog-meta">{range} · {posts.length} posts</p>
        <p class="blog-intro">The blog I kept during my design degree: coursework, research and the things inspiring me at the time, kept as I wrote it.</p>
      </header>

      <div class="blog-controls" hidden>
        <label class="visually-hidden" for="blog-search">Search posts</label>
        <input id="blog-search" class="blog-search" type="search" placeholder="Search posts…" autocomplete="off" />
        <div class="blog-cats" role="group" aria-label="Filter by category">
          <button type="button" class="blog-cat" data-cat="" aria-pressed="true">All <span class="timeline-tab-count">{posts.length}</span></button>
          {showFixing && fixingCount > 0 && (
            <button type="button" class="blog-cat blog-cat-fixing" data-cat="needs-fixing" data-name="Needs fixing" aria-pressed="false">Needs fixing <span class="timeline-tab-count">{fixingCount}</span></button>
          )}
          {categories.map((c) => (
            <button type="button" class="blog-cat" data-cat={c.slug} data-name={c.name} aria-pressed="false">{c.name} <span class="timeline-tab-count">{c.count}</span></button>
          ))}
        </div>
        <p class="blog-status" aria-live="polite"></p>
      </div>
    </aside>

    <div class="blog-posts">
      <header class="blog-results" hidden>
        <h2 class="blog-results-title"></h2>
        <p class="blog-results-count"></p>
      </header>
      <p class="blog-empty" hidden>No posts match.</p>
      {rendered.map(({ post, Content }) => (
        <article class="blog-post" id={post.id} data-cats={[...post.data.categories.map(slugify), ...(deadIn(post.body).length ? ['needs-fixing'] : [])].join(' ')}>
          <div class="blog-post-meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateFmt.format(post.data.date)}</time>
            {post.data.categories.map((c, i) => (
              <>{i === 0 ? ' · ' : ', '}<span class="blog-post-cat" data-cat={slugify(c)}>{c}</span></>
            ))}
            {deadIn(post.body).length > 0 && <span class="blog-post-fixing"> · {deadIn(post.body).length} dead {deadIn(post.body).length === 1 ? 'link' : 'links'}</span>}
          </div>
          <h2 class="blog-post-title"><a href={`#${post.id}`}>{post.data.title}</a></h2>
          <div class="blog-body">
            <Content />
          </div>
          {post.data.tags.length > 0 && <div class="blog-tags">{post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}</div>}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { matches, normalize, readState, writeState, findRanges } from '../lib/blog-filter';

  const view = document.querySelector<HTMLElement>('.blog-view')!;
  const controls = view.querySelector<HTMLElement>('.blog-controls')!;
  const input = view.querySelector<HTMLInputElement>('#blog-search')!;
  const chips = [...view.querySelectorAll<HTMLButtonElement>('.blog-cat')];
  const empty = view.querySelector<HTMLElement>('.blog-empty')!;
  const status = view.querySelector<HTMLElement>('.blog-status')!;
  const results = view.querySelector<HTMLElement>('.blog-results')!;
  const resultsTitle = results.querySelector<HTMLElement>('.blog-results-title')!;
  const resultsCount = results.querySelector<HTMLElement>('.blog-results-count')!;
  const catLabels = [...view.querySelectorAll<HTMLElement>('.blog-post-cat')];
  const knownCats = (view.dataset.cats ?? '').split(' ').filter(Boolean);
  const posts = [...view.querySelectorAll<HTMLElement>('.blog-post')].map((el) => ({
    el,
    // Title, date, categories, body and tags are all in the post's own text
    text: normalize(el.textContent ?? '').replace(/\s+/g, ' '),
    categorySlugs: (el.dataset.cats ?? '').split(' ').filter(Boolean),
  }));

  let state = readState(location.search, knownCats);

  function apply() {
    let shown = 0;
    for (const p of posts) {
      const ok = matches(p, state.q, state.cat);
      p.el.hidden = !ok;
      // The first visible post drops its top rule so it never doubles up with the line above
      p.el.classList.toggle('is-first', ok && shown === 0);
      if (ok) shown++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.cat || null) === state.cat)));
    empty.hidden = shown > 0;
    // With a category selected, the heading above the posts carries the count instead
    status.textContent = state.q && !state.cat ? `${shown} of ${posts.length} posts` : '';
    // Name the selected category above the posts and mark it inside each post
    const chip = chips.find((c) => c.dataset.cat === state.cat);
    results.hidden = !chip;
    if (chip) {
      resultsTitle.textContent = chip.dataset.name ?? '';
      resultsCount.textContent = `${shown} ${shown === 1 ? 'post' : 'posts'}${state.q ? ` matching “${state.q}”` : ''}`;
    }
    for (const el of catLabels) el.classList.toggle('is-active', el.dataset.cat === state.cat);
    highlight();
    history.replaceState(history.state, '', `${location.pathname}${writeState(state)}${location.hash}`);
  }

  // Mark search matches in the visible posts' titles, bodies and tags (CSS Custom Highlight API;
  // browsers without it simply show no marks)
  const canHighlight = typeof Highlight !== 'undefined' && 'highlights' in CSS;
  function highlight() {
    if (!canHighlight) return;
    CSS.highlights.delete('blog-search');
    if (!state.q) return;
    const ranges: Range[] = [];
    for (const p of posts) {
      if (p.el.hidden) continue;
      for (const root of p.el.querySelectorAll('.blog-post-title, .blog-body, .blog-tags')) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
          for (const [start, end] of findRanges(node.nodeValue ?? '', state.q)) {
            const r = new Range();
            r.setStart(node, start);
            r.setEnd(node, end);
            ranges.push(r);
          }
        }
      }
    }
    CSS.highlights.set('blog-search', new Highlight(...ranges));
  }

  // After filtering from further down, start the results from the top (side column is sticky)
  const toTop = () => {
    if (view.getBoundingClientRect().top < 0) view.scrollIntoView({ behavior: 'smooth' });
  };

  controls.hidden = false;
  input.value = state.q;
  apply();

  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state = { ...state, q: input.value.trim() };
      apply();
      toTop();
    }, 120);
  });
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      state = { ...state, cat: c.dataset.cat || null };
      apply();
      toTop();
    })
  );

  // Dev server only: mark dead links (from npm run blog:check-links) with the reason on hover
  const deadData = document.getElementById('blog-dead-links');
  if (deadData) {
    const deadLinks: Record<string, string> = JSON.parse(deadData.textContent || '{}');
    for (const a of view.querySelectorAll<HTMLAnchorElement>('.blog-body a[href^="http"]')) {
      const reason = deadLinks[a.getAttribute('href') ?? ''];
      if (reason) {
        a.classList.add('is-dead');
        a.title = `Dead link: ${reason}`;
      }
    }
  }

  // Videos: a link until clicked, then the real player. YouTube thumbnails load near the viewport.
  const embeds = [...view.querySelectorAll<HTMLAnchorElement>('a.video-embed')];
  const thumbs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const a = e.target as HTMLAnchorElement;
        a.style.backgroundImage = `url(https://i.ytimg.com/vi/${a.dataset.id}/hqdefault.jpg)`;
        thumbs.unobserve(a);
      }
    },
    { rootMargin: '600px' }
  );
  for (const a of embeds) {
    a.setAttribute('aria-label', `Play video (${a.dataset.provider === 'youtube' ? 'YouTube' : 'Vimeo'})`);
    a.dataset.label = a.dataset.provider === 'youtube' ? 'YouTube' : 'Vimeo';
    if (a.dataset.provider === 'youtube') thumbs.observe(a);
    a.addEventListener('click', (ev) => {
      ev.preventDefault();
      const id = a.dataset.id;
      const frame = document.createElement('iframe');
      frame.className = 'video-embed-frame';
      frame.src =
        a.dataset.provider === 'youtube'
          ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`
          : `https://player.vimeo.com/video/${id}?${a.dataset.hash ? `h=${a.dataset.hash}&` : ''}autoplay=1`;
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.allowFullscreen = true;
      frame.title = 'Video';
      a.replaceWith(frame);
    });
  }
</script>
