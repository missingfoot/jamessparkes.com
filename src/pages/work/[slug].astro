---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../components/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.visible && data.category === 'work');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout
  title={project.data.title}
  seoTitle={project.data.seoTitle}
  cover={project.data.cover ?? project.data.images[0]?.src}
  coverAlt={project.data.cover ? undefined : project.data.images[0]?.alt}
  description={project.data.description}
  tags={project.data.tags}
  images={project.data.images}
  path={`/work/${project.id}`}
  role={project.data.role}
  years={project.data.years}
  highlights={project.data.highlights}
>
  <Content />
</ProjectLayout>
